# Build artifacts
/target/
**/target/

# Generated sample outputs
samples/*.docx
samples/*.pdf
samples/*.html
samples/*.md
samples/~$*

# OS files
.DS_Store
Thumbs.db

# Editor files
*.swp
*.swo
*~
.idea/
.vscode/
*.iml

# Temporary files
/tmp/
*.tmp

# Workflow scratch. In-flight notes and sprint run state are local memory,
# not the delivery record. The record lives in docs/sprints/.
.claude/scratch/
.claude/settings.local.json

# Deck corpus. Fetched by a script rather than committed, so the published
# crates stay small. See docs/hld/12-testing-strategy.md.
/corpus/

# Python bytecode from the gate scripts under scripts/.
__pycache__/
*.pyc
