import os as _os
from collections.abc import Iterator as _Iterator
from typing import NoReturn as _Never, final as _final, overload as _overload

from .enum.shapes import MSO_SHAPE as _MSO_SHAPE
from .util import Length as _Length

_Path = str | _os.PathLike[str]
__all__ = [
    "Presentation", "SlideLayout", "SlideLayoutCollection", "Slide",
    "SlideCollection", "Shape", "ShapeCollection", "PlaceholderCollection",
    "TextFrame", "Paragraph", "ParagraphCollection", "Run", "RunCollection",
    "Font", "Table", "Column", "ColumnCollection", "Cell",
]


@_final
class Presentation:
    def __new__(cls, path: _Path | None = None) -> Presentation: ...
    def save(self, path: _Path) -> None: ...
    def to_bytes(self) -> bytes: ...
    @property
    def slide_layouts(self) -> SlideLayoutCollection: ...
    @property
    def slides(self) -> SlideCollection: ...


@_final
class SlideLayout:
    def __new__(cls, *, _private: _Never) -> SlideLayout: ...
    @property
    def name(self) -> str | None: ...


@_final
class SlideLayoutCollection:
    def __new__(cls, *, _private: _Never) -> SlideLayoutCollection: ...
    def __len__(self) -> int: ...
    @_overload
    def __getitem__(self, key: int, /) -> SlideLayout: ...
    @_overload
    def __getitem__(self, key: slice, /) -> list[SlideLayout]: ...
    def __iter__(self) -> _Iterator[SlideLayout]: ...


@_final
class Slide:
    def __new__(cls, *, _private: _Never) -> Slide: ...
    @property
    def shapes(self) -> ShapeCollection: ...
    @property
    def placeholders(self) -> PlaceholderCollection: ...


@_final
class SlideCollection:
    def __new__(cls, *, _private: _Never) -> SlideCollection: ...
    def __len__(self) -> int: ...
    @_overload
    def __getitem__(self, key: int, /) -> Slide: ...
    @_overload
    def __getitem__(self, key: slice, /) -> list[Slide]: ...
    def __iter__(self) -> _Iterator[Slide]: ...
    def add_slide(self, layout: SlideLayout) -> Slide: ...


@_final
class Shape:
    def __new__(cls, *, _private: _Never) -> Shape: ...
    @property
    def shapes(self) -> ShapeCollection: ...
    @property
    def text(self) -> str: ...
    @text.setter
    def text(self, value: str) -> None: ...
    @property
    def has_text_frame(self) -> bool: ...
    @property
    def text_frame(self) -> TextFrame: ...
    @property
    def has_table(self) -> bool: ...
    @property
    def table(self) -> Table: ...


@_final
class ShapeCollection:
    def __new__(cls, *, _private: _Never) -> ShapeCollection: ...
    def __len__(self) -> int: ...
    @_overload
    def __getitem__(self, key: int, /) -> Shape: ...
    @_overload
    def __getitem__(self, key: slice, /) -> list[Shape]: ...
    def __iter__(self) -> _Iterator[Shape]: ...
    @property
    def title(self) -> Shape | None: ...
    @property
    def placeholders(self) -> PlaceholderCollection: ...
    def add_textbox(self, left: int, top: int, width: int, height: int) -> Shape: ...
    def add_shape(
        self, shape_type: _MSO_SHAPE, left: int, top: int, width: int, height: int
    ) -> Shape: ...
    def add_table(
        self, rows: int, cols: int, left: int, top: int, width: int, height: int
    ) -> Shape: ...
    def add_picture(
        self,
        image_file: _Path,
        left: int,
        top: int,
        width: int | None = None,
        height: int | None = None,
    ) -> Shape: ...


@_final
class PlaceholderCollection:
    def __new__(cls, *, _private: _Never) -> PlaceholderCollection: ...
    def __getitem__(self, placeholder_idx: int, /) -> Shape: ...


